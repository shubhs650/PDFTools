{
  "name": "pdftools",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Free, offline, private PDF editor PWA for engineers",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=e2e",
    "perf": "playwright test --project=perf --pass-with-no-tests",
    "licenses": "node scripts/check-licenses.ts",
    "spikes": "playwright test -c spikes/playwright.config.ts",
    "typecheck:spikes": "tsc -p spikes",
    "corpus": "node scripts/fetch-corpus.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@embedpdf/engines": "^2.15.1",
    "@embedpdf/models": "^2.15.1",
    "@embedpdf/pdfium": "^2.15.1",
    "asn1js": "^3.0.10",
    "pdf-oxide-wasm": "^0.3.77",
    "pkijs": "^3.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
