// Cloudflare Worker configuration for a Git-connected Worker (Workers Builds).
// The app itself is a static site: `npm run build` writes `dist/`, which the
// Worker serves as static assets (with `dist/_headers`: the §10.1 CSP, COOP/COEP).
// The Worker script only answers `POST /api/report` (D-22), the same handler as
// the Pages Function. Cloudflare's build runs wrangler on its side; wrangler is
// not a dependency of this repository (ADR-003).
//
// Two Workers (ADR-029, D-28):
// - `pdftools` (the top level): the beta and staging site,
//   pdftools.shubhampatil650.workers.dev, built by Cloudflare Workers Builds
//   from every push to `main` (deploy command `npx wrangler deploy`), with a
//   preview per PR branch (`npx wrangler preview`), Node 22 from `.nvmrc`.
// - `triya-pdf` (env `production`): the release, on app.triyapdf.com and
//   triya-pdf.openengtools.com. Only .github/workflows/release.yml deploys it
//   (`wrangler deploy --env production`), from a version tag, after approval.
//   Workers Builds never touches it, so a push to `main` cannot reach the
//   release domains.
// See docs/deploy/release.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdftools",
  "compatibility_date": "2026-09-01",
  "main": "functions/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // No 404.html: unknown paths get index.html, as on Pages (SPA fallback).
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
  },
  "workers_dev": true,
  // Worker Previews (one per PR branch, built by `npx wrangler preview`). The
  // command refuses to run without this block; empty means previews inherit
  // the settings above. `npx wrangler versions upload` does not work there:
  // Workers Builds rejects it on preview branches with a Worker-name mismatch.
  "previews": {},
  "observability": {
    "enabled": false,
  },
  // Error reports (docs/deploy/error-report.md). Bindings of a Worker live here,
  // not in the dashboard (a deploy replaces dashboard bindings). Uncomment and
  // fill in once the D1 database exists; `REPORT_SALT` is a secret
  // (`npx wrangler secret put REPORT_SALT`, or the dashboard → Secrets).
  // "d1_databases": [
  //   { "binding": "REPORT_DB", "database_name": "pdftools-reports", "database_id": "<id>" }
  // ],
  // "send_email": [{ "name": "REPORT_MAIL" }],
  // "vars": { "REPORT_MAIL_FROM": "reports@example.com", "REPORT_MAIL_TO": "you@example.com" }

  "env": {
    // The release Worker (D-28). Bindings are not inherited by an environment:
    // when error reports are switched on, repeat the D1/email/vars here too.
    "production": {
      "name": "triya-pdf",
      "workers_dev": false,
      "preview_urls": false,
      // Both domains serve the app (each its own origin). Custom Domains need
      // both zones in this Cloudflare account; wrangler adds the DNS records
      // and certificates.
      "routes": [
        { "pattern": "app.triyapdf.com", "custom_domain": true },
        { "pattern": "triya-pdf.openengtools.com", "custom_domain": true },
      ],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "html_handling": "auto-trailing-slash",
      },
      "observability": {
        "enabled": false,
      },
    },
  },
}
